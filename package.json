{
  "name": "sistema-metales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:validar": "tsx scripts/validar-migraciones.ts",
    "db:push": "node scripts/supabase.mjs db push",
    "db:types": "node scripts/supabase.mjs gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "supabase:conectar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/conectar-supabase.ps1",
    "sb": "node scripts/supabase.mjs",
    "supabase:clave": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cambiar-clave-bd.ps1",
    "guia": "tsx --tsconfig scripts/guia-cliente/tsconfig.json scripts/guia-cliente/generar.tsx",
    "demo:preparar": "node scripts/preparar-demo.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.58.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "unrs-resolver",
      "sharp",
      "esbuild"
    ]
  }
}
