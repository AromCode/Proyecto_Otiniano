# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role / secret key (SOLO servidor, nunca al navegador)

# Opcional: consulta DNI/RUC (apis.net.pe u otro proveedor compatible). Sin token se registra a mano.
CONSULTA_DOC_TOKEN=
CONSULTA_DOC_URL=https://api.apis.net.pe/v2
