# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role / secret key (SOLO servidor, nunca al navegador)

# Opcional: consulta DNI (RENIEC) / RUC (SUNAT) con Decolecta (decolecta.com). Sin token se registra a mano.
# Cada documento se consulta una sola vez (queda guardado en padron_documentos).
CONSULTA_DOC_TOKEN=
CONSULTA_DOC_URL=https://api.decolecta.com/v1
# Tope de consultas nuevas por empresa y día (cuida la cuota gratuita)
CONSULTA_DOC_LIMITE_DIA=30

# Opcional, solo desarrollo: botón "Entrar directo" en /login
DEV_LOGIN_EMAIL=
# Opcional: más usuarios de prueba para el acceso directo, separados por coma
DEV_LOGIN_EMAILS=
# Opcional: empresa que abre el acceso directo (parte del nombre; por defecto la que contiene "Demo")
DEV_LOGIN_EMPRESA=
